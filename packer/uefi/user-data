#cloud-config
autoinstall:
    version: 1
    locale: en_US.UTF-8
    refresh-installer:
        update: no
    keyboard:
        layout: us
        variant: ""
    network:
        network:
            version: 2
            ethernets:
                default:
                    match:
                        name: e*
                    dhcp4: yes
    apt:
        primary:
            - arches: [default]
              uri: http://archive.ubuntu.com/ubuntu/
    storage:
        grub:
            update_nvram: true
        swap:
            size: 0
        layout:
            name: direct
    identity:
        username: vagrant
        hostname: ubuntu.localdomain
        password: "$6$pniguAcReslhK$wwOrj4o.CXt6HL7NiOZ2J7/UOC4ivAIVs8BU/h6qpRIBdWX824Qg.VQadCVQCAJNr4/Fv3J55Zf936Jm5dlKT/"
    ssh:
        install-server: yes
        allow-pw: yes
    user-data:
        disable_root: false
    packages:
        - ca-certificates
        - cloud-guest-utils
        - cloud-init
        - curl
        - e2fsprogs
        - iproute2
        - openssh-server
        - perl
        - gcc
        - locales
        - python3
        - rsync
        - sudo
        - qemu-guest-agent
        - nfs-common
    # early-commands:
    #     - systemctl stop ssh.service
    late-commands:
        # Write EFI fallback bootloader to /boot/efi/EFI/BOOT/BOOTX64.EFI so the
        # image boots from a blank OVMF NVRAM without needing stored EFI boot entries.
        - curtin in-target --target=/target -- apt-get install -y grub-efi-amd64
        - curtin in-target --target=/target -- grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ubuntu --removable
        - curtin in-target --target=/target -- update-grub
        - |
            curtin in-target --target=/target -- /bin/bash -c ' \
                echo "root:vagrant" | chpasswd; \
                rm -rf /root/.bash_logout || true; \
                mkdir -p /root/.ssh; \
                chmod 0700 /root/.ssh; \
                echo "ssh-rsa  vagrant insecure public key" > /root/.ssh/authorized_keys; \
                chmod 0600 /root/.ssh/authorized_keys; \
                chown -Rf root:root /root; \
                mkdir -p /home/vagrant/.ssh; \
                chmod 0700 /home/vagrant/.ssh; \
                echo "ssh-rsa  vagrant insecure public key" > /home/vagrant/.ssh/authorized_keys; \
                chmod 0600 /home/vagrant/.ssh/authorized_keys; \
                chown -Rf vagrant:vagrant /home/vagrant; \
                mkdir -p /etc/sudoers.d; \
                chmod 0755 /etc/sudoers.d; \
                echo "vagrant ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/vagrant; \
                chmod 0440 /etc/sudoers.d/vagrant; \
                chown -Rf root:root /etc/sudoers.d; \
                ssh-keygen -A; \
                systemctl enable ssh.service; \
                systemctl disable apt-daily.service; \
                systemctl disable apt-daily.timer; \
                systemctl disable apt-daily-upgrade.service; \
                systemctl disable apt-daily-upgrade.timer; \
                exit 0 \
            '
