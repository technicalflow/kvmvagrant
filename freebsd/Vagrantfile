# -*- mode: ruby -*-
# vi: set ft=ruby :

vmhostname = "msklafb13dnss01"
vmip = "192.168.50.242"

Vagrant.configure("2") do |config|
  config.vm.box = "bento/freebsd-13"
  config.vm.hostname = "#{manager_hostname}"

  config.vm.provider :libvirt do |libvirt|
    libvirt.cpus = 2
    libvirt.memory = 1024
    libvirt.nested = true
    libvirt.video_type = "vga"
    libvirt.video_vram = 16384
    libvirt.machine_type = "q35"
    libvirt.nic_model_type = "virtio"
    libvirt.cpu_mode = "host-passthrough"
    # Add Serial for qemu agent communication
    libvirt.channel :type => 'unix', :target_name => 'org.qemu.guest_agent.0', :target_type => 'virtio', :disabled => false
    libvirt.serial :type => "pty"

  end

#  config.vm.network "public_network", bridge: "enp2s0f0"
#  config.vm.network :private_network, ip: "192.168.121.190"
#  config.vm.network :private_network, :ip => "192.168.122.200"
#  config.vm.network :forwarded_port, guest: 80, host: 8090, host_ip: "0.0.0.0"

  config.vm.network :public_network,
      :dev => "br0",
      :mode => "bridge",
      :type => "bridge",
      :ip => "#{vmip}"

  config.vm.synced_folder ".", "/vagrant",
    # owner: "vagrant", group: "vagrant"
    # Working setting for RHEL10
    type: "nfs",
    nfs_version: 4,
    nfs_udp: false 

  config.vm.provision "shell", inline: "mkdir -p /home/vagrant/.ssh/"
  config.vm.provision "file", source: "../ansible/ansible.pub", destination: "/home/vagrant/.ssh/ansible.pub"
  config.vm.provision "shell", inline: "cat /home/vagrant/.ssh/ansible.pub >> /home/vagrant/.ssh/authorized_keys"

  config.vm.provision "shell", run: "once", inline: <<-SHELL
    pkg update
    pkg upgrade -y
    pkg install -y mc htop nano bash qemu-guest-agent
    sysrc qemu_guest_agent_enable=YES
    sysrc hostname="#{vmhostname}"
    chsh -s /usr/local/bin/bash vagrant
    sed -i '' 's/#{vmhostname}/#{vmhostname}.local/' /etc/hosts
    openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32 | sudo pw usermod vagrant -h 0
    uname -a
    ifconfig | grep inet
  SHELL

  config.vm.provision "shell", path: "./provision.sh", run: "once"

end
